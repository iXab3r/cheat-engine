;
; dea64.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=dea64.cat
DriverVer= ; TODO: set DriverVer in stampinf property pages

[DestinationDirs]
DefaultDestDir = 12
dea64_Device_CoInstaller_CopyFiles = 11

; ================= Class section =====================

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
dea64.sys  = 1,,
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll=1 ; make sure the number matches with SourceDisksNames

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%dea64.DeviceDesc%=dea64_Device, Root\dea64 ; TODO: edit hw-id

[dea64_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
dea64.sys

;-------------- Service installation
[dea64_Device.NT.Services]
AddService = dea64,%SPSVCINST_ASSOCSERVICE%, dea64_Service_Inst

; -------------- dea64 driver install sections
[dea64_Service_Inst]
DisplayName    = %dea64.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\dea64.sys

;
;--- dea64_Device Coinstaller installation ------
;

[dea64_Device.NT.CoInstallers]
AddReg=dea64_Device_CoInstaller_AddReg
CopyFiles=dea64_Device_CoInstaller_CopyFiles

[dea64_Device_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll,WdfCoInstaller"

[dea64_Device_CoInstaller_CopyFiles]
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll

[dea64_Device.NT.Wdf]
KmdfService =  dea64, dea64_wdfsect
[dea64_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="Cheat Engine" ;TODO: Replace with your manufacturer name
ClassName="System" ; TODO: edit ClassName
DiskName = "dea64 Installation Disk"
dea64.DeviceDesc = "dea64 Device"
dea64.SVCDESC = "dea64 Service"
